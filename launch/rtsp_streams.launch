<launch>

  <!-- Stream configuration file. Override to use your own without editing the package:
       roslaunch ros_rtsp rtsp_streams.launch config:=/abs/path/to/my_streams.yaml -->
  <arg name="config" default="$(find ros_rtsp)/config/stream_setup.yaml" />

  <!-- Nodelet manager. A dedicated manager is started by default. The name is
       intentionally unique ("rtsp_nodelet_manager", not the very common
       "standalone_nodelet") so it can't clash with another manager on the system
       - a name clash makes ROS shut one of them down, taking the RTSP server with
       it. To load into an existing manager (e.g. your camera driver's) for
       zero-copy image transport on `topic` streams:
       roslaunch ros_rtsp rtsp_streams.launch start_manager:=false manager:=<existing_manager> -->
  <arg name="manager" default="rtsp_nodelet_manager" />
  <arg name="start_manager" default="true" />

  <!-- Start the RTSP server (nodelet manager process) -->
  <node if="$(arg start_manager)" pkg="nodelet" type="nodelet"
        name="$(arg manager)" args="manager" output="screen" />

  <!-- Load the RTSP nodelet and hand it the stream setup -->
  <node pkg="nodelet" type="nodelet" name="Image2RTSPNodelet"
        args="load image2rtsp/Image2RTSPNodelet $(arg manager)" output="screen">
    <rosparam command="load" file="$(arg config)" />
  </node>

</launch>
